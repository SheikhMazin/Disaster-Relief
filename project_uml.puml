@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 70
skinparam defaultFontSize 11
skinparam wrapWidth 300
skinparam classFontStyle bold
skinparam classAttributeFontSize 10
skinparam padding 5
skinparam roundcorner 5

skinparam class {
  BackgroundColor White
  BorderColor #444444
  ArrowColor #444444
  HeaderBackgroundColor #DDEEFF
}

' ─────────────────────────────────────────────
'  ROW 1: Entry Point
' ─────────────────────────────────────────────

class Main {
  +{static} main(args : String[]) : void
}

class MainFrame {
  -controller : ReliefController
  --
  +MainFrame(controller : ReliefController)
  +showMainMenu() : void
  +showVictimManagement() : void
  +showSupplyManagement() : void
  +showInquiryManagement() : void
  +showSkillManagement() : void
  +showRequirementManagement() : void
  +showMessage(message : String) : void
  +showError(errorMessage : String) : void
}

class ReliefController {
  -victimService : DisasterVictimService
  -supplyService : SupplyService
  -inquiryService : InquiryService
  -requirementService : RequirementService
  -skillService : SkillService
  --
  +ReliefController(victimService : DisasterVictimService,\n  supplyService : SupplyService,\n  inquiryService : InquiryService,\n  requirementService : RequirementService,\n  skillService : SkillService)
  +startApplication() : void
}

' ─────────────────────────────────────────────
'  ROW 2: Infrastructure
' ─────────────────────────────────────────────

class ActionLogger {
  -{static} instance : ActionLogger
  -{static} LOG_FILE : String = "data/action_log.txt"
  --
  -ActionLogger()
  +{static} getInstance() : ActionLogger
  +logAdded(entityType : String, description : String) : void
  +logUpdated(entityType : String, description : String) : void
  +logDeleted(entityType : String, description : String) : void
  +logSoftDeleted(entityType : String, description : String) : void
  -writeEntry(entry : String) : void
}

class DatabaseManager {
  -{static} instance : DatabaseManager
  -connection : Connection
  -url : String
  -username : String
  -password : String
  --
  -DatabaseManager()
  +{static} getInstance() : DatabaseManager
  +connect() : Connection
  +disconnect() : void
  +getConnection() : Connection
}

interface DataRepository {
  +loadVictims() : ArrayList<DisasterVictim>
  +loadLocations() : ArrayList<Location>
  +loadSupplies() : ArrayList<Supply>
  +loadInquiries() : ArrayList<ReliefService>
  +saveVictim(victim : DisasterVictim) : void
  +updateVictim(victim : DisasterVictim) : void
  +softDeleteVictim(victimID : int) : void
  +hardDeleteVictim(victimID : int) : void
  +saveSupply(supply : Supply) : void
  +updateSupply(supply : Supply) : void
  +saveInquiry(inquiry : ReliefService) : void
  +updateInquiry(inquiry : ReliefService) : void
  +saveRequirement(requirement : VictimRequirement) : void
  +deleteRequirement(victimID : int, requirementType : String) : void
  +saveSkill(skill : Skill) : void
  +deleteSkill(skillID : int) : void
}

class PostgreSQLDataRepository {
  -dbManager : DatabaseManager
  --
  +PostgreSQLDataRepository(dbManager : DatabaseManager)
  +loadVictims() : ArrayList<DisasterVictim>
  +loadLocations() : ArrayList<Location>
  +loadSupplies() : ArrayList<Supply>
  +loadInquiries() : ArrayList<ReliefService>
  +saveVictim(victim : DisasterVictim) : void
  +updateVictim(victim : DisasterVictim) : void
  +softDeleteVictim(victimID : int) : void
  +hardDeleteVictim(victimID : int) : void
  +saveSupply(supply : Supply) : void
  +updateSupply(supply : Supply) : void
  +saveInquiry(inquiry : ReliefService) : void
  +updateInquiry(inquiry : ReliefService) : void
  +saveRequirement(requirement : VictimRequirement) : void
  +deleteRequirement(victimID : int, requirementType : String) : void
  +saveSkill(skill : Skill) : void
  +deleteSkill(skillID : int) : void
}

' ─────────────────────────────────────────────
'  ROW 3: Services
' ─────────────────────────────────────────────

class DisasterVictimService {
  -repository : DataRepository
  -logger : ActionLogger
  -victims : ArrayList<DisasterVictim>
  --
  +DisasterVictimService(repository : DataRepository, logger : ActionLogger)
  +loadVictims() : ArrayList<DisasterVictim>
  +addVictim(victim : DisasterVictim) : void
  +updateVictim(victim : DisasterVictim) : void
  +getVictimByID(victimID : int) : DisasterVictim
  +getActiveVictims() : ArrayList<DisasterVictim>
  +softDeleteVictim(victimID : int) : void
  +hardDeleteVictim(victimID : int) : void
  +addMedicalRecord(victimID : int, record : MedicalRecord) : void
  +addFamilyConnection(victimID : int, relation : FamilyRelation) : void
  +addRequirement(victimID : int, requirement : VictimRequirement) : void
  +removeRequirement(victimID : int, requirementType : String) : void
  +addSkill(victimID : int, skill : Skill) : void
  +removeSkill(victimID : int, skillID : int) : void
}

class SupplyService {
  -repository : DataRepository
  -logger : ActionLogger
  -supplies : ArrayList<Supply>
  --
  +SupplyService(repository : DataRepository, logger : ActionLogger)
  +loadSupplies() : ArrayList<Supply>
  +addSupply(supply : Supply) : void
  +updateSupply(supply : Supply) : void
  +allocateSupply(supplyID : int, victimID : int) : void
  +getAvailableSupplies() : ArrayList<Supply>
  +getExpiredSupplies() : ArrayList<Supply>
  +warnExpiredSupplies() : String
}

class InquiryService {
  -repository : DataRepository
  -logger : ActionLogger
  -inquiries : ArrayList<ReliefService>
  --
  +InquiryService(repository : DataRepository, logger : ActionLogger)
  +loadInquiries() : ArrayList<ReliefService>
  +addInquiry(inquiry : ReliefService) : void
  +updateInquiry(inquiry : ReliefService) : void
}

class RequirementService {
  -repository : DataRepository
  -availableOptions : HashMap<String, Set<String>>
  --
  +RequirementService(repository : DataRepository)
  +loadAvailableRequirements(fileName : String) : void
  +getAvailableRequirementTypes() : Set<String>
  +getOptionsForType(requirementType : String) : Set<String>
  +isValidOption(requirementType : String, selectedOption : String) : boolean
}

class SkillService {
  -repository : DataRepository
  -logger : ActionLogger
  --
  +SkillService(repository : DataRepository, logger : ActionLogger)
  +addSkill(victimID : int, skill : Skill) : void
  +removeSkill(victimID : int, skillID : int) : void
  +searchByCategory(category : String) : ArrayList<Skill>
  +getVictimSkills(victimID : int) : ArrayList<Skill>
}

' ─────────────────────────────────────────────
'  ROW 4: Domain Classes
' ─────────────────────────────────────────────

class DisasterVictim {
  -victimID : int
  -firstName : String
  -lastName : String
  -dateOfBirth : LocalDate
  -approximateAge : Integer
  -gender : String
  -comments : String
  -softDeleted : boolean = false
  -ENTRY_DATE : LocalDate
  -familyConnections : ArrayList<FamilyRelation>
  -medicalRecords : ArrayList<MedicalRecord>
  -personalBelongings : ArrayList<Supply>
  -requirements : ArrayList<VictimRequirement>
  -skills : ArrayList<Skill>
  --
  +DisasterVictim(victimID : int, firstName : String, entryDate : LocalDate)
  +DisasterVictim(victimID : int, firstName : String, entryDate : LocalDate, dateOfBirth : LocalDate)
  +DisasterVictim(victimID : int, firstName : String, entryDate : LocalDate, approximateAge : int)
  +getVictimID() : int
  +getFirstName() : String
  +setFirstName(firstName : String) : void
  +getLastName() : String
  +setLastName(lastName : String) : void
  +getDateOfBirth() : LocalDate
  +setDateOfBirth(dateOfBirth : LocalDate) : void
  +getApproximateAge() : Integer
  +setApproximateAge(approximateAge : int) : void
  +getGender() : String
  +setGender(gender : String) : void
  +getComments() : String
  +setComments(comments : String) : void
  +getEntryDate() : LocalDate
  +isSoftDeleted() : boolean
  +softDelete() : void
  +getFamilyConnections() : ArrayList<FamilyRelation>
  +getMedicalRecords() : ArrayList<MedicalRecord>
  +getPersonalBelongings() : ArrayList<Supply>
  +getRequirements() : ArrayList<VictimRequirement>
  +getSkills() : ArrayList<Skill>
  +addPersonalBelonging(belonging : Supply) : void
  +removePersonalBelonging(belonging : Supply) : void
  +addFamilyConnection(connection : FamilyRelation) : void
  +removeFamilyConnection(connection : FamilyRelation) : void
  +addMedicalRecord(record : MedicalRecord) : void
  +addRequirement(requirement : VictimRequirement) : void
  +removeRequirement(requirementType : String) : void
  +addSkill(skill : Skill) : void
  +removeSkill(skillID : int) : void
}

class FamilyRelation {
  -personOne : DisasterVictim
  -relationshipTo : String
  -personTwo : DisasterVictim
  --
  +FamilyRelation(personOne : DisasterVictim,\n  relationshipTo : String, personTwo : DisasterVictim)
  +getPersonOne() : DisasterVictim
  +setPersonOne(personOne : DisasterVictim) : void
  +getRelationshipTo() : String
  +setRelationshipTo(relationshipTo : String) : void
  +getPersonTwo() : DisasterVictim
  +setPersonTwo(personTwo : DisasterVictim) : void
}

class MedicalRecord {
  -location : Location
  -treatmentDetails : String
  -dateOfTreatment : LocalDate
  --
  +MedicalRecord(location : Location,\n  treatmentDetails : String, dateOfTreatment : LocalDate)
  +getLocation() : Location
  +setLocation(location : Location) : void
  +getTreatmentDetails() : String
  +setTreatmentDetails(treatmentDetails : String) : void
  +getDateOfTreatment() : LocalDate
  +setDateOfTreatment(dateOfTreatment : LocalDate) : void
}

class Location {
  -locationID : int
  -name : String
  -address : String
  -occupants : ArrayList<DisasterVictim>
  -supplies : ArrayList<Supply>
  --
  +Location(locationID : int, locationName : String, address : String)
  +getLocationID() : int
  +getName() : String
  +setName(locationName : String) : void
  +getAddress() : String
  +setAddress(address : String) : void
  +getOccupants() : ArrayList<DisasterVictim>
  +setOccupants(occupants : ArrayList<DisasterVictim>) : void
  +getSupplies() : ArrayList<Supply>
  +setSupplies(inventory : ArrayList<Supply>) : void
  +addOccupant(occupant : DisasterVictim) : void
  +removeOccupant(occupant : DisasterVictim) : void
  +addSupply(inventory : Supply) : void
  +removeSupply(inventory : Supply) : void
}

class Supply {
  -supplyID : int
  -type : String
  -quantity : int
  -perishable : boolean
  -expiryDate : LocalDate
  -allocatedVictim : DisasterVictim
  --
  +Supply(supplyID : int, type : String, quantity : int)
  +Supply(supplyID : int, type : String, quantity : int,\n  perishable : boolean, expiryDate : LocalDate)
  +getSupplyID() : int
  +getType() : String
  +setType(type : String) : void
  +getQuantity() : int
  +setQuantity(quantity : int) : void
  +isPerishable() : boolean
  +setPerishable(perishable : boolean) : void
  +getExpiryDate() : LocalDate
  +setExpiryDate(expiryDate : LocalDate) : void
  +isExpired() : boolean
  +allocateTo(victim : DisasterVictim) : void
  +getAllocatedVictim() : DisasterVictim
}

class Inquirer {
  -inquirerID : int
  -FIRST_NAME : String
  -LAST_NAME : String
  -INFO : String
  -SERVICES_PHONE : String
  --
  +Inquirer(inquirerID : int, firstName : String,\n  lastName : String, phone : String, info : String)
  +getInquirerID() : int
  +getFirstName() : String
  +getLastName() : String
  +getServicesPhoneNum() : String
  +getInfo() : String
}

class ReliefService {
  -inquiryID : int
  -inquirer : Inquirer
  -missingPerson : DisasterVictim
  -dateOfInquiry : LocalDate
  -infoProvided : String
  -lastKnownLocation : Location
  --
  +ReliefService(inquiryID : int, inquirer : Inquirer,\n  missingPerson : DisasterVictim, inquiryDate : LocalDate,\n  infoProvided : String, lastLocation : Location)
  +getInquiryID() : int
  +getInquirer() : Inquirer
  +setInquirer(inquirer : Inquirer) : void
  +getMissingPerson() : DisasterVictim
  +setMissingPerson(missingPerson : DisasterVictim) : void
  +getDateOfInquiry() : LocalDate
  +setDateOfInquiry(inquiryDate : LocalDate) : void
  +getInfoProvided() : String
  +setInfoProvided(info : String) : void
  +getLastKnownLocation() : Location
  +setLastKnownLocation(lastLocation : Location) : void
  +getLogDetails() : String
}

class VictimRequirement {
  -victimID : int
  -requirementType : String
  -selectedOption : String
  --
  +VictimRequirement(victimID : int,\n  requirementType : String, selectedOption : String)
  +getVictimID() : int
  +getRequirementType() : String
  +getSelectedOption() : String
  +setSelectedOption(selectedOption : String) : void
}

' ─────────────────────────────────────────────
'  Skills Hierarchy
' ─────────────────────────────────────────────

abstract class Skill {
  -skillID : int
  -victimID : int
  -category : String
  -proficiencyLevel : String
  --
  +Skill(skillID : int, victimID : int,\n  category : String, proficiencyLevel : String)
  +getSkillID() : int
  +getVictimID() : int
  +getCategory() : String
  +getProficiencyLevel() : String
  +setProficiencyLevel(proficiencyLevel : String) : void
}

class MedicalSkill {
  -certificationType : String
  -certificationExpiryDate : LocalDate
  --
  +MedicalSkill(skillID : int, victimID : int, proficiencyLevel : String,\n  certificationType : String, certificationExpiryDate : LocalDate)
  +getCertificationType() : String
  +setCertificationType(certificationType : String) : void
  +getCertificationExpiryDate() : LocalDate
  +setCertificationExpiryDate(certificationExpiryDate : LocalDate) : void
}

class LanguageSkill {
  -languageName : String
  -readWrite : boolean
  -speakListen : boolean
  --
  +LanguageSkill(skillID : int, victimID : int, proficiencyLevel : String,\n  languageName : String, readWrite : boolean, speakListen : boolean)
  +getLanguageName() : String
  +setLanguageName(languageName : String) : void
  +hasReadWrite() : boolean
  +hasSpeakListen() : boolean
}

class TradeSkill {
  -tradeType : String
  --
  +TradeSkill(skillID : int, victimID : int,\n  proficiencyLevel : String, tradeType : String)
  +getTradeType() : String
  +setTradeType(tradeType : String) : void
}

' ─────────────────────────────────────────────
'  Exceptions
' ─────────────────────────────────────────────

class IllegalArgumentException <<Exception>>
class IOException <<Exception>>
class ClassNotFoundException <<Exception>>
class SQLException <<Exception>>

' ─────────────────────────────────────────────
'  Layout hints
' ─────────────────────────────────────────────

Main -[hidden]right-> MainFrame
MainFrame -[hidden]right-> ReliefController

ReliefController -[hidden]down-> DisasterVictimService
DisasterVictimService -[hidden]right-> SupplyService
SupplyService -[hidden]right-> InquiryService
InquiryService -[hidden]right-> RequirementService
RequirementService -[hidden]right-> SkillService

ActionLogger -[hidden]right-> DatabaseManager
DatabaseManager -[hidden]right-> DataRepository
DataRepository -[hidden]right-> PostgreSQLDataRepository

DisasterVictimService -[hidden]down-> DisasterVictim
InquiryService -[hidden]down-> ReliefService
SkillService -[hidden]down-> Skill

DisasterVictim -[hidden]right-> FamilyRelation
FamilyRelation -[hidden]right-> MedicalRecord
MedicalRecord -[hidden]right-> Location
Location -[hidden]right-> Supply
Supply -[hidden]right-> VictimRequirement
VictimRequirement -[hidden]right-> Inquirer
Inquirer -[hidden]right-> ReliefService

Skill -[hidden]right-> MedicalSkill
MedicalSkill -[hidden]right-> LanguageSkill
LanguageSkill -[hidden]right-> TradeSkill

' ─────────────────────────────────────────────
'  Relationships
' ─────────────────────────────────────────────

Main --> MainFrame
MainFrame --> ReliefController

ReliefController --> DisasterVictimService
ReliefController --> SupplyService
ReliefController --> InquiryService
ReliefController --> RequirementService
ReliefController --> SkillService

DisasterVictimService --> DataRepository
DisasterVictimService --> ActionLogger
SupplyService --> DataRepository
SupplyService --> ActionLogger
InquiryService --> DataRepository
InquiryService --> ActionLogger
RequirementService --> DataRepository
SkillService --> DataRepository
SkillService --> ActionLogger

PostgreSQLDataRepository ..|> DataRepository
PostgreSQLDataRepository --> DatabaseManager

Skill <|-- MedicalSkill
Skill <|-- LanguageSkill
Skill <|-- TradeSkill

DisasterVictim "1" o-- "0..*" FamilyRelation
DisasterVictim "1" o-- "0..*" MedicalRecord
DisasterVictim "1" o-- "0..*" Supply
DisasterVictim "1" o-- "0..*" VictimRequirement
DisasterVictim "1" o-- "0..*" Skill

Location "1" o-- "0..*" DisasterVictim
Location "1" o-- "0..*" Supply

MedicalRecord "0..*" --> "1" Location
FamilyRelation "0..*" --> "2" DisasterVictim
ReliefService "1" --> "1" Inquirer
ReliefService "1" --> "1" DisasterVictim
ReliefService "1" --> "0..1" Location
Supply "0..1" --> "0..1" DisasterVictim : allocated to

DisasterVictim ..> IllegalArgumentException : <<throws>>
Supply ..> IllegalArgumentException : <<throws>>
RequirementService ..> IOException : <<throws>>
RequirementService ..> ClassNotFoundException : <<throws>>
DatabaseManager ..> SQLException : <<throws>>
PostgreSQLDataRepository ..> SQLException : <<throws>>

@enduml
